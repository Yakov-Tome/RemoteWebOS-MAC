{
  "appId": "com.remotec.app",
  "productName": "RemoteC",
  "npmRebuild": false,
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron-main.js",
    "server.js",
    "tv-client.js",
    "config.json",
    "config.example.json",
    "public/**/*",
    "package.json",
    "node_modules/**/*"
  ],
  "extraResources": [
    { "from": "config.example.json", "to": "config.example.json" }
  ],
  "mac": {
    "category": "public.app-category.utilities",
    "icon": "build/icon.icns",
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] }
    ]
  }
}
